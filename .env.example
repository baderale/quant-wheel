# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# Only the council + weekly agent need an LLM. The quant core, backtest, scan,
# and tracker all work with NO key and NO LLM.

# Which LLM provider the council/agent use: anthropic | ollama | openai | google
QUANTWHEEL_PROVIDER=ollama

# Model id (optional — sensible default per provider if omitted).
#   anthropic -> claude-sonnet-4-6   ollama -> llama3.2
#   openai    -> gpt-4o-mini         google -> gemini-1.5-flash
QUANTWHEEL_MODEL=llama3.2

# Sampling temperature for the personas (optional).
# QUANTWHEEL_TEMPERATURE=0.3

# --- Local: Ollama (no API key) -------------------------------------------
# Run `ollama serve` and pull a tool/JSON-capable model, e.g.:
#   ollama pull llama3.2          (or qwen2.5, mistral-nemo)
# Tiny models (e.g. gemma3:270m) can't do structured output — avoid them.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Local: any OpenAI-compatible server (vLLM, LM Studio, etc.) -----------
# QUANTWHEEL_PROVIDER=openai
# QUANTWHEEL_MODEL=your-local-model
# QUANTWHEEL_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=not-needed-but-some-servers-want-any-value

# --- Cloud providers (set the matching key) -------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
