# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.

# Required only for the agent layer (council + LangGraph weekly agent).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model the council/agent uses.
# Default is a fast, cheap model; bump to opus for the deepest reasoning.
QUANTWHEEL_MODEL=claude-sonnet-4-6
